# ContextWeaver Environment Variables

# Required
MINIMAX_API_KEY=your_minimax_api_key_here
JINA_API_KEY=your_jina_ai_api_key_here

# Optional
CW_DB_PATH=./context-weaver.db        # SQLite database path
CW_WS_PORT=7070                     # WebSocket server port (fallback: 7071, 7072)
CW_REST_PORT=7070                    # REST API port
